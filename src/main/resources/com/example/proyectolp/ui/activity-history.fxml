<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.ActivityHistoryController" styleClass="app-bg">
    <top>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4">
                    <Label text="ACTIVIDAD" styleClass="kicker"/>
                    <Label text="HISTORIAL" styleClass="h2"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Volver al Dashboard" onAction="#backToDashboard" styleClass="btn-ghost"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <ComboBox fx:id="categoryFilter" prefWidth="160"/>
                <DatePicker fx:id="fromFilter" promptText="Desde"/>
                <DatePicker fx:id="throughFilter" promptText="Hasta"/>
                <TextField fx:id="searchField" promptText="Buscar en la actividad" HBox.hgrow="ALWAYS"/>
                <Button fx:id="filterButton" text="Filtrar" onAction="#applyFilters" styleClass="btn-primary"/>
                <Button fx:id="clearButton" text="Limpiar" onAction="#clearFilters" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="8" right="24" bottom="20" left="24"/></padding>
            <Label fx:id="statusLabel" wrapText="true" styleClass="text-error"/>
            <TableView fx:id="activityTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Fecha y hora" prefWidth="190"/>
                    <TableColumn fx:id="categoryColumn" text="Categoría" prefWidth="145"/>
                    <TableColumn fx:id="summaryColumn" text="Acción" prefWidth="560"/>
                </columns>
                <placeholder><Label text="Aún no hay actividad registrada."/></placeholder>
            </TableView>
            <HBox alignment="CENTER">
                <Button fx:id="loadMoreButton" text="Cargar más" onAction="#loadMore" disable="true"/>
            </HBox>
            <VBox spacing="6" styleClass="card">
                <Label text="DETALLE" styleClass="kicker"/>
                <TextArea fx:id="detailArea" editable="false" wrapText="true" prefRowCount="4"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
