<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="dashboardRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.DashboardController">
    <top><HBox alignment="CENTER_LEFT" spacing="16"><padding><Insets top="18" right="22" bottom="12" left="22"/></padding>
        <Label text="Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;"/><HBox HBox.hgrow="ALWAYS"/><Button fx:id="btnTareas" text="Tareas" onAction="#abrirTareas"/><Button fx:id="btnProyectos" text="Proyectos" onAction="#abrirProyectos"/><Button fx:id="btnHabitos" text="Hábitos" onAction="#abrirHabitos"/><Button fx:id="btnActualizar" text="Actualizar" onAction="#refrescar"/>
        <Button fx:id="btnFinanzas" text="Finanzas" onAction="#abrirFinanzas"/>
    </HBox></top>
    <center><ScrollPane fitToWidth="true"><content><GridPane hgap="14" vgap="14" style="-fx-padding: 10 22 22 22;">
        <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
        <VBox spacing="9" style="-fx-background-color: white; -fx-border-color: #d9dee7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Tareas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <GridPane hgap="12" vgap="10">
                <Label text="Pendientes" GridPane.columnIndex="0" GridPane.rowIndex="0"/><Label fx:id="lblPendientes" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="En progreso" GridPane.columnIndex="0" GridPane.rowIndex="1"/><Label fx:id="lblEnProgreso" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Completadas" GridPane.columnIndex="0" GridPane.rowIndex="2"/><Label fx:id="lblCompletadas" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Vencidas" GridPane.columnIndex="0" GridPane.rowIndex="3"/><Label fx:id="lblVencidas" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane><Label fx:id="lblTareasError" wrapText="true" style="-fx-text-fill: #b42318;"/>
        </VBox>
        <VBox spacing="9" style="-fx-background-color: white; -fx-border-color: #d9dee7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Proyectos activos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <VBox fx:id="boxProyectos" spacing="12"/><Label fx:id="lblProyectosError" wrapText="true" style="-fx-text-fill: #b42318;"/>
        </VBox>
        <VBox spacing="9" style="-fx-background-color: white; -fx-border-color: #d9dee7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Hábitos de hoy" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <VBox fx:id="boxHabitos" spacing="8"/><Label fx:id="lblHabitosError" wrapText="true" style="-fx-text-fill: #b42318;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-border-color: #d9dee7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Racha de productividad" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblRacha" text="—" style="-fx-font-size: 48px; -fx-font-weight: bold;"/>
            <Label fx:id="lblRachaError" text="días consecutivos" wrapText="true"/>
        </VBox>
        <VBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: white; -fx-border-color: #d9dee7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Estado financiero" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblFinancialBalance" text="—" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Button text="Abrir Finanzas" onAction="#abrirFinanzas"/><Label fx:id="lblFinancialError" wrapText="true" style="-fx-text-fill: #b42318;"/>
        </VBox>
    </GridPane></content></ScrollPane></center>
</BorderPane>
