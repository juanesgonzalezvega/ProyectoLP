<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.FinancesController">
    <top><HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 18 22 12 22;"><Button text="Dashboard" onAction="#volverDashboard"/><Label text="Finanzas" style="-fx-font-size: 24px; -fx-font-weight: bold;"/><HBox HBox.hgrow="ALWAYS"/><Button text="Actualizar" onAction="#cargar"/><fx:include source="session-menu.fxml"/></HBox></top>
    <center><TabPane><tabs>
        <Tab text="Movimientos" closable="false"><VBox spacing="10" style="-fx-padding: 14;"><HBox spacing="8"><ComboBox fx:id="cmbFilterType" promptText="Tipo"/><TextField fx:id="txtFilterCategory" promptText="Categoría"/><TextField fx:id="txtFilterMonth" promptText="Mes YYYY-MM"/><Button text="Nuevo movimiento" onAction="#nuevoMovimiento"/><Button fx:id="btnEditMovement" text="Editar" onAction="#editarMovimiento"/><Button fx:id="btnDeleteMovement" text="Eliminar" onAction="#eliminarMovimiento"/></HBox><TableView fx:id="tblMovements" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colType" text="Tipo" prefWidth="90"/><TableColumn fx:id="colAmount" text="Monto" prefWidth="120"/><TableColumn fx:id="colDate" text="Fecha" prefWidth="120"/><TableColumn fx:id="colCategory" text="Categoría" prefWidth="160"/><TableColumn fx:id="colDescription" text="Descripción" prefWidth="280"/></columns></TableView><Label fx:id="lblMessage" wrapText="true"/></VBox></Tab>
        <Tab text="Balance y estadísticas" closable="false"><VBox spacing="12" style="-fx-padding: 14;"><HBox spacing="24"><VBox><Label text="Disponible total"/><Label fx:id="lblAvailable" style="-fx-font-size: 20px; -fx-font-weight: bold;"/><Label fx:id="lblAvailableUsd" text="≈ —"/></VBox><VBox><Label text="Ingresos totales"/><Label fx:id="lblIncomeTotal"/><Label fx:id="lblIncomeTotalUsd" text="≈ —"/></VBox><VBox><Label text="Gastos totales"/><Label fx:id="lblExpenseTotal"/><Label fx:id="lblExpenseTotalUsd" text="≈ —"/></VBox><VBox><Label text="Gasto del mes"/><Label fx:id="lblMonthlyExpenses"/><Label fx:id="lblMonthlyExpensesUsd" text="≈ —"/></VBox><VBox><Label text="Ahorro del mes"/><Label fx:id="lblMonthlyBalance"/><Label fx:id="lblMonthlyBalanceUsd" text="≈ —"/></VBox></HBox><Label text="Equivalencias con la TRM de hoy, no con la tasa del día de cada movimiento." style="-fx-font-size: 10px;"/><HBox spacing="20" VBox.vgrow="ALWAYS"><PieChart fx:id="chartCategories" title="Gastos por categoría" prefWidth="420"/><BarChart fx:id="chartEvolution" title="Ingresos y gastos por mes" animated="false" prefWidth="600"><xAxis><CategoryAxis label="Mes"/></xAxis><yAxis><NumberAxis label="Monto" forceZeroInRange="true"/></yAxis></BarChart></HBox><Label fx:id="lblStatsError" wrapText="true"/></VBox></Tab>
        <Tab text="Dólar (TRM)" closable="false"><VBox spacing="12" style="-fx-padding: 18;"><Label fx:id="lblTrmValue" text="Cargando TRM…" style="-fx-font-size: 22px; -fx-font-weight: bold;"/><Label fx:id="lblTrmDate" text="Fecha de vigencia: —"/><Label fx:id="lblTrmStatus" text="Consultando fuente…"/><Label text="Fuente: Superintendencia Financiera de Colombia / datos.gov.co"/><Button text="Actualizar TRM" onAction="#actualizarTrm"/><Label text="Convertidor" style="-fx-font-weight: bold;"/><TextField fx:id="txtConvertAmount" promptText="Monto (sin separadores de miles)"/><ComboBox fx:id="cmbConvertDirection"/><Label fx:id="lblConverterResult" text=""/><Label text="Equivalencias con la TRM de hoy, no con la tasa del día de cada movimiento." wrapText="true"/></VBox></Tab><Tab text="Metas" closable="false"><VBox spacing="10" style="-fx-padding: 14;"><HBox spacing="8"><Button text="Nueva meta" onAction="#nuevaMeta"/><Button fx:id="btnEditGoal" text="Editar" onAction="#editarMeta"/><Button fx:id="btnDeleteGoal" text="Eliminar" onAction="#eliminarMeta"/><Button fx:id="btnContribute" text="Registrar aporte" onAction="#aportar"/></HBox><VBox fx:id="boxGoals" spacing="12"/></VBox></Tab>
    </tabs></TabPane></center>
</BorderPane>
