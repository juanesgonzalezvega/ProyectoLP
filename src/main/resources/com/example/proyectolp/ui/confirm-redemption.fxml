<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10" stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.ConfirmRedemptionController">
 <Label text="CONFIRMAR CANJE" styleClass="kicker"/><Label fx:id="productLabel" styleClass="h2"/><Label fx:id="merchantLabel"/><Label fx:id="costLabel"/><Label fx:id="balanceLabel"/><Label fx:id="simulationLabel" text="SIMULACIÓN ACADÉMICA: el cupón no tiene valor real." wrapText="true"/>
 <HBox spacing="8"><Button text="CANCELAR" onAction="#cancel"/><Button text="CONFIRMAR CANJE" onAction="#confirm" styleClass="btn-primary"/></HBox>
