<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="root" stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.ForgotPasswordController" alignment="CENTER" spacing="12" prefWidth="480" prefHeight="560" styleClass="app-bg">
    <padding><Insets top="28" right="36" bottom="28" left="36"/></padding>
    <Label text="Recuperar contrase&#x00F1;a" styleClass="h2" wrapText="true"/>
    <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false" prefWidth="28" prefHeight="28"/>
    <VBox fx:id="stepEmail" spacing="12" alignment="CENTER">
        <Label text="Escribe el correo de tu cuenta para recibir un c&#x00F3;digo de recuperaci&#x00F3;n." wrapText="true"/>
        <TextField fx:id="emailField" promptText="Correo electr&#x00F3;nico" maxWidth="340" onAction="#sendCode"/>
        <Button fx:id="sendCodeButton" text="Enviar c&#x00F3;digo" onAction="#sendCode" defaultButton="true" maxWidth="340"/>
        <Label fx:id="step1Message" wrapText="true" styleClass="text-error"/>
        <Hyperlink text="Volver al inicio de sesi&#x00F3;n" onAction="#backToLogin"/>
    </VBox>
    <VBox fx:id="stepCode" spacing="12" alignment="CENTER" visible="false" managed="false">
        <Label fx:id="deliveryLabel" text="Te enviamos un c&#x00F3;digo de 6 d&#x00ED;gitos a" wrapText="true"/>
        <TextField fx:id="codeField" promptText="C&#x00F3;digo de 6 d&#x00ED;gitos" maxWidth="340" onAction="#changePassword"/>
        <PasswordField fx:id="newPasswordField" promptText="Nueva contrase&#x00F1;a (m&#x00ED;nimo 8 caracteres)" maxWidth="340"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirmar contrase&#x00F1;a" maxWidth="340" onAction="#changePassword"/>
        <Button fx:id="changePasswordButton" text="Cambiar contrase&#x00F1;a" onAction="#changePassword" defaultButton="true" maxWidth="340"/>
        <Hyperlink fx:id="resendLink" text="Reenviar c&#x00F3;digo" onAction="#resendCode"/>
        <Hyperlink text="Usar otro correo" onAction="#useOtherEmail"/>
        <Label fx:id="step2Message" wrapText="true" styleClass="text-error"/>
    </VBox>
</VBox>
