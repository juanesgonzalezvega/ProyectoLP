<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.RoutineFormController" spacing="9" prefWidth="440">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <Label text="Nombre de rutina"/><TextField fx:id="nameField" promptText="Ej. Tren superior"/>
 <Label text="Descripción"/><TextField fx:id="descriptionField"/>
 <HBox spacing="8"><TextField fx:id="exerciseField" promptText="Ejercicio"/><ComboBox fx:id="muscleCombo" promptText="Grupo muscular"/><Button text="Agregar" onAction="#addExercise"/></HBox>
 <ListView fx:id="exerciseList" prefHeight="220"/><HBox spacing="8"><Button text="↑" onAction="#moveUp"/><Button text="↓" onAction="#moveDown"/><Button text="Quitar" onAction="#removeExercise"/></HBox>
 <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: #b42318;"/>
</VBox>
