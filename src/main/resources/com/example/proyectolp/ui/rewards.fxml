<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.RewardsController">
 <top><HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 14;"><Button text="Volver" onAction="#back"/><Label text="Recompensas" style="-fx-font-size: 22px; -fx-font-weight: bold;"/><Label fx:id="message"/><HBox HBox.hgrow="ALWAYS"/><fx:include source="session-menu.fxml"/></HBox></top>
 <center><TabPane>
  <Tab text="Créditos" closable="false"><VBox spacing="10" style="-fx-padding: 14;"><Label fx:id="balanceLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;"/><Label fx:id="copLabel"/><HBox spacing="12"><Label fx:id="habitsBreakdown"/><Label fx:id="tasksBreakdown"/><Label fx:id="projectsBreakdown"/><Label fx:id="goalsBreakdown"/><Label fx:id="penaltiesBreakdown"/></HBox><ComboBox fx:id="originFilter" promptText="Filtrar origen"/><TableView fx:id="ledgerTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="dateCol" text="Fecha"/><TableColumn fx:id="conceptCol" text="Concepto"/><TableColumn fx:id="creditsCol" text="Créditos"/></columns></TableView><Label text="Dónde redimir (referencias informativas; no hay canje integrado)"/><Label text="Rappi · DiDi · Uber · KFC · Frisby · restaurantes de cadena" wrapText="true"/></VBox></Tab>
  <Tab text="Progreso" closable="false"><VBox spacing="12" style="-fx-padding: 20;"><Label fx:id="xpLabel"/><Label fx:id="levelLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;"/><Label fx:id="rankLabel"/><ProgressBar fx:id="levelProgress" maxWidth="Infinity"/><Label fx:id="nextLevelLabel"/><Label fx:id="streakLabel"/><Label fx:id="penaltyLabel" wrapText="true"/></VBox></Tab>
  <Tab text="Insignias" closable="false"><FlowPane fx:id="badgeGrid" hgap="12" vgap="12" style="-fx-padding: 20;"/></Tab>
  <Tab text="Misiones" closable="false"><ListView fx:id="missionList"/></Tab>
 </TabPane></center>
</BorderPane>
