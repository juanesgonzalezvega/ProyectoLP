<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.RewardsController" styleClass="app-bg">
 <top><HBox spacing="12" alignment="CENTER_LEFT"><Button text="Volver" onAction="#back"/><Label text="Recompensas" styleClass="h2"/><Label fx:id="message"/><HBox HBox.hgrow="ALWAYS"/><fx:include source="session-menu.fxml"/></HBox></top>
 <center><TabPane>
  <Tab text="Créditos" closable="false"><VBox spacing="10"><Label fx:id="balanceLabel" styleClass="h2"/><Label fx:id="copLabel"/><HBox spacing="12"><Label fx:id="habitsBreakdown"/><Label fx:id="tasksBreakdown"/><Label fx:id="projectsBreakdown"/><Label fx:id="goalsBreakdown"/><Label fx:id="penaltiesBreakdown"/><Label fx:id="redemptionsBreakdown"/></HBox><ComboBox fx:id="originFilter" promptText="Filtrar origen"/><TableView fx:id="ledgerTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="dateCol" text="Fecha"/><TableColumn fx:id="conceptCol" text="Concepto"/><TableColumn fx:id="creditsCol" text="Créditos"/></columns></TableView></VBox></Tab>
  <Tab text="Progreso" closable="false"><VBox spacing="12"><Label fx:id="xpLabel"/><Label fx:id="levelLabel" styleClass="h2"/><Label fx:id="rankLabel"/><ProgressBar fx:id="levelProgress" maxWidth="Infinity"/><Label fx:id="nextLevelLabel"/><Label fx:id="streakLabel"/><Label fx:id="penaltyLabel" wrapText="true"/></VBox></Tab>
  <Tab text="Insignias" closable="false"><FlowPane fx:id="badgeGrid" hgap="12" vgap="12"/></Tab>
  <Tab text="Misiones" closable="false"><ListView fx:id="missionList"/></Tab>
  <Tab text="Redimir" closable="false"><fx:include fx:id="redeemView" source="redeem-view.fxml"/></Tab>
 </TabPane></center>
</BorderPane>
