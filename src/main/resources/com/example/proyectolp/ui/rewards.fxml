  <Tab text="Misiones" closable="false"><ListView fx:id="missionList"/></Tab>
  <Tab text="Redimir" closable="false">
   <ScrollPane fitToWidth="true">
    <content>
     <FlowPane hgap="12" vgap="12" style="-fx-padding: 20;">
