<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="merchantCardRoot" spacing="8" stylesheets="@../css/theme.css" styleClass="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.MerchantMenuController">
 <fx:define><ContextMenu fx:id="merchantContextMenu"><items><MenuItem fx:id="miOpenMerchant" text="Ver productos" onAction="#open"/><MenuItem fx:id="miVisitWebsite" text="Visitar sitio web" onAction="#visitWebsite"/></items></ContextMenu></fx:define>
 <Label fx:id="categoryLabel" styleClass="kicker"/><Label fx:id="nameLabel" styleClass="h2"/><Button text="VER PRODUCTOS" onAction="#open" styleClass="btn-primary"/>
</VBox>
