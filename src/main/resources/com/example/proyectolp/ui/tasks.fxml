<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.TasksController" styleClass="app-bg">
    <top><VBox spacing="14"><padding><Insets top="18" right="22" bottom="12" left="22"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="14"><Button text="← Dashboard" onAction="#volverDashboard"/><Label text="Tareas" styleClass="h2"/><HBox HBox.hgrow="ALWAYS"/><Button fx:id="btnNew" text="Nueva tarea" onAction="#nuevaTarea"/><fx:include source="session-menu.fxml"/></HBox>
        <HBox alignment="CENTER_LEFT" spacing="10"><Label text="Filtrar por estado:"/><ComboBox fx:id="cmbFilter" prefWidth="180"/><Label fx:id="lblMessage" wrapText="true" styleClass="text-muted"/></HBox>
    </VBox></top>
    <center><TableView fx:id="tblTasks">
        <contextMenu><ContextMenu fx:id="taskRowMenu"><items>
                <MenuItem fx:id="miCompleteTask" text="Completar" onAction="#completarTarea"/>
                <MenuItem fx:id="miTaskAttachments" text="Adjuntos…" onAction="#openAttachments"/>
                <MenuItem fx:id="miEditTask" text="Editar" onAction="#editarTarea"/>
                <SeparatorMenuItem/>
                <MenuItem fx:id="miDeleteTask" text="Eliminar" onAction="#eliminarTarea" styleClass="menu-item-danger"/>
            </items></ContextMenu></contextMenu>
        <fx:define><ContextMenu fx:id="taskEmptyMenu"><items><MenuItem fx:id="miNewTask" text="Nueva tarea" onAction="#nuevaTarea"/></items></ContextMenu></fx:define>
        <columns>
            <TableColumn fx:id="colName" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="colPriority" text="Prioridad" prefWidth="95"/>
            <TableColumn fx:id="colStatus" text="Estado" prefWidth="110"/>
            <TableColumn fx:id="colDueDate" text="Fecha límite" prefWidth="115"/>
            <TableColumn fx:id="colProgress" text="Progreso" prefWidth="90"/>
            <TableColumn fx:id="colCategory" text="Categoría" prefWidth="120"/>
        </columns>
        <placeholder><Label text="No hay tareas para mostrar."/></placeholder>
    </TableView></center>
    <bottom><HBox alignment="CENTER_RIGHT" spacing="10"><padding><Insets top="12" right="22" bottom="18" left="22"/></padding>
        <Button fx:id="btnComplete" text="Completar" onAction="#completarTarea"/>
        <Button fx:id="btnAttachments" text="Adjuntos" onAction="#openAttachments"/>
        <Button fx:id="btnEdit" text="Editar" onAction="#editarTarea"/>
        <Button fx:id="btnDelete" text="Eliminar" onAction="#eliminarTarea"/>
    </HBox></bottom>
</BorderPane>
