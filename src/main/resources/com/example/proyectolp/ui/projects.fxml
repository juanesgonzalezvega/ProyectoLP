<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane stylesheets="@../css/theme.css" fx:id="projectsRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.ProjectsController" styleClass="app-bg">
    <top><HBox alignment="CENTER_LEFT" spacing="14"><padding><Insets top="18" right="22" bottom="14" left="22"/></padding>
        <Button text="← Dashboard" onAction="#volverDashboard"/>
        <Label text="Proyectos" styleClass="h2"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <fx:include source="session-menu.fxml"/>
        <Button fx:id="btnNewProject" text="Nuevo proyecto" onAction="#nuevoProyecto"/>
    </HBox></top>
    <center><GridPane hgap="14" vgap="10">
        <columnConstraints><ColumnConstraints percentWidth="48"/><ColumnConstraints percentWidth="52"/></columnConstraints>
        <TableView fx:id="tblProjects" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.rowSpan="2">
            <contextMenu><ContextMenu fx:id="projectRowMenu"><items>
                    <MenuItem fx:id="miProjectAttachments" text="Adjuntos…" onAction="#openAttachments"/>
                    <MenuItem fx:id="miEditProject" text="Editar" onAction="#editarProyecto"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="miDeleteProject" text="Eliminar" onAction="#eliminarProyecto" styleClass="menu-item-danger"/>
                </items></ContextMenu></contextMenu>
            <fx:define><ContextMenu fx:id="projectEmptyMenu"><items><MenuItem fx:id="miNewProject" text="Nuevo proyecto" onAction="#nuevoProyecto"/></items></ContextMenu></fx:define>
            <columns>
                <TableColumn fx:id="colProjectName" text="Proyecto" prefWidth="180"/>
                <TableColumn fx:id="colProjectDeadline" text="Fecha límite" prefWidth="110"/>
                <TableColumn fx:id="colProjectProgress" text="Progreso" prefWidth="100"/>
            </columns>
            <placeholder><Label text="No hay proyectos. Crea uno para comenzar."/></placeholder>
        </TableView>
        <VBox spacing="10" styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label fx:id="lblSelectedName" text="Selecciona un proyecto" styleClass="h2"/>
            <Label fx:id="lblSelectedDeadline" text=""/>
            <ProgressBar fx:id="barProgress" progress="0" maxWidth="Infinity"/>
            <Label fx:id="lblProgressText" text="Sin etapas"/>
            <HBox spacing="8"><Button fx:id="btnEdit" text="Editar" onAction="#editarProyecto"/><Button fx:id="btnAttachments" text="Adjuntos" onAction="#openAttachments"/><Button fx:id="btnDelete" text="Eliminar" onAction="#eliminarProyecto"/></HBox>
        </VBox>
        <VBox spacing="8" styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Etapas" styleClass="h2"/>
            <ListView fx:id="listProjectStages" prefHeight="220" VBox.vgrow="ALWAYS">
                <contextMenu><ContextMenu fx:id="stageRowMenu"><items>
                        <Menu fx:id="stageStatusMenu" text="Marcar como"><items>
                            <MenuItem fx:id="miStagePending" text="Pendiente" onAction="#marcarEtapaPendiente"/>
                            <MenuItem fx:id="miStageInProgress" text="En progreso" onAction="#marcarEtapaEnProgreso"/>
                            <MenuItem fx:id="miStageCompleted" text="Completada" onAction="#marcarEtapaCompletada"/>
                        </items></Menu>
                    </items></ContextMenu></contextMenu>
            </ListView>
            <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Estado:"/><ComboBox fx:id="cmbStageStatus" prefWidth="170"/><Button fx:id="btnUpdateStage" text="Guardar estado" onAction="#guardarEstadoEtapa"/></HBox>
        </VBox>
    </GridPane></center>
    <bottom><Label fx:id="lblMessage" wrapText="true" styleClass="text-muted"/></bottom>
</BorderPane>
