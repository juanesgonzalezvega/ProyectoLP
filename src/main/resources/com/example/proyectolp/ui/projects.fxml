<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="projectsRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectolp.controller.ProjectsController">
    <top><HBox alignment="CENTER_LEFT" spacing="14"><padding><Insets top="18" right="22" bottom="14" left="22"/></padding>
        <Button text="← Dashboard" onAction="#volverDashboard"/>
        <Label text="Proyectos" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo proyecto" onAction="#nuevoProyecto"/>
    </HBox></top>
    <center><GridPane hgap="14" vgap="10" style="-fx-padding: 0 22 18 22;">
        <columnConstraints><ColumnConstraints percentWidth="48"/><ColumnConstraints percentWidth="52"/></columnConstraints>
        <TableView fx:id="tblProjects" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.rowSpan="2">
            <columns>
                <TableColumn fx:id="colProjectName" text="Proyecto" prefWidth="180"/>
                <TableColumn fx:id="colProjectDeadline" text="Fecha límite" prefWidth="110"/>
                <TableColumn fx:id="colProjectProgress" text="Progreso" prefWidth="100"/>
            </columns>
            <placeholder><Label text="No hay proyectos. Crea uno para comenzar."/></placeholder>
        </TableView>
        <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #d9dee7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label fx:id="lblSelectedName" text="Selecciona un proyecto" style="-fx-font-size: 19px; -fx-font-weight: bold;"/>
            <Label fx:id="lblSelectedDeadline" text=""/>
            <ProgressBar fx:id="barProgress" progress="0" maxWidth="Infinity"/>
            <Label fx:id="lblProgressText" text="Sin etapas"/>
            <HBox spacing="8"><Button fx:id="btnEdit" text="Editar" onAction="#editarProyecto"/><Button fx:id="btnDelete" text="Eliminar" onAction="#eliminarProyecto"/></HBox>
        </VBox>
        <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #d9dee7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Etapas" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
            <ListView fx:id="listProjectStages" prefHeight="220" VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Estado:"/><ComboBox fx:id="cmbStageStatus" prefWidth="170"/><Button fx:id="btnUpdateStage" text="Guardar estado" onAction="#guardarEstadoEtapa"/></HBox>
        </VBox>
    </GridPane></center>
    <bottom><Label fx:id="lblMessage" wrapText="true" style="-fx-padding: 0 22 14 22; -fx-text-fill: #555;"/></bottom>
</BorderPane>
